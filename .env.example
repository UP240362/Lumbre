# Plantilla: copia este archivo como .env.local y llena los valores.
# Los encuentras en Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo para publicar con Docker (npm run docker:internet).
# Cloudflare → Zero Trust → Networks → Tunnels → tu túnel → token.
# Es SECRETO: con él cualquiera podría conectar su equipo a tu dominio.
CLOUDFLARE_TUNNEL_TOKEN=

# Opcional: carpeta de la Biblioteca Lumbre (libros que todos pueden leer).
# Si no se pone, se usa C:\Lumbre\libros. SOLO libros de dominio público.
LUMBRE_BIBLIOTECA=
